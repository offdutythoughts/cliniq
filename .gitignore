# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-pw/
/out/

# playwright (the tests/visual/__screenshots__ baselines ARE committed)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# isolated tsconfig Next mutates during the test build (keeps app tsconfig clean)
/tsconfig.pw.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude session files (but keep shared, checked-in skills)
.claude/*
!.claude/skills/

# Playwright MCP scratch artifacts (snapshots, console logs)
.playwright-mcp/
